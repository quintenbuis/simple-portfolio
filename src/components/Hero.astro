---
import { profile } from '../config';
import type { I18nData } from '../lib/schemas';
import EmailLink from './EmailLink.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  t: I18nData;
}

const { t } = Astro.props;
---
<section class="hero container">
  <EmailLink class="availability">
    <span class="availability-dot" aria-hidden="true"></span>
    {t.hero.availability}
  </EmailLink>
  <h1>
    <span class="hero-name">{profile.name}</span>{' '}
    <span class="hero-title">{t.hero.title}</span>
  </h1>
  <p class="hero-pitch">{t.hero.pitch}</p>
  <div class="hero-actions">
    <EmailLink class="button" label={t.hero.cta} />
    <SocialLinks />
  </div>
</section>
