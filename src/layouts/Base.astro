---
import '../styles/global.css';
import { profile } from '../config';
import { defaultLocale, localePath, locales, type Locale } from '../lib/i18n';
import type { I18nData } from '../lib/schemas';

interface Props {
  lang: Locale;
  t: I18nData;
}

const { lang, t } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(localePath(lang));
const ogImage = abs(`${localePath(defaultLocale)}og.png`);
const ogLocales = { nl: 'nl_NL', en: 'en_US' };
const root = localePath(defaultLocale);
const home = abs(root);
const personId = `${home}#person`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      jobTitle: t.hero.title,
      description: t.meta.description,
      url: home,
      image: ogImage,
      email: `mailto:${profile.email}`,
      address: { '@type': 'PostalAddress', addressCountry: 'NL' },
      knowsAbout: profile.technologies.map((tech) => tech.name),
      sameAs: [profile.githubUrl, profile.linkedinUrl],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${home}#business`,
      name: profile.businessName,
      url: home,
      email: `mailto:${profile.email}`,
      image: ogImage,
      founder: { '@id': personId },
      address: { '@type': 'PostalAddress', addressCountry: 'NL' },
      areaServed: { '@type': 'Country', name: 'NL' },
      identifier: { '@type': 'PropertyValue', propertyID: 'KvK', value: profile.kvk },
      vatID: profile.vatNumber,
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: profile.name,
      inLanguage: lang,
      publisher: { '@id': personId },
    },
  ],
}).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(defaultLocale))} />
    <link rel="icon" href={`${root}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${root}favicon-96.png`} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={`${root}apple-touch-icon.png`} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${t.hero.title}`} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
    {profile.analyticsScriptUrl && (
      <>
        {/* Privacy-friendly analytics by Plausible */}
        <script is:inline async src={profile.analyticsScriptUrl}></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
    <script is:inline>
      document.querySelectorAll('[data-email-user]').forEach((el) => {
        const address = el.dataset.emailUser + '@' + el.dataset.emailDomain;
        el.href = 'mailto:' + address;
        if (el.hasAttribute('data-email-show')) el.textContent = address;
      });
    </script>
  </body>
</html>
